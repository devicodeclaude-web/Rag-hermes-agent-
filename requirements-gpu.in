# Dependances directes du groupe [gpu] (miroir de pyproject.toml).
# Compile en lockfile hashe avec :
#   uv pip compile requirements-gpu.in \
#     --generate-hashes \
#     --python-platform x86_64-manylinux2014 \
#     --python-version 3.12 \
#     -o requirements-gpu.lock.txt
# La cible est la plateforme du POD (Linux x86_64 + Python 3.12), pas Termux.
#
# NOTE lock autonome : ce fichier reste aussi l'entree du lock GPU historique
# `requirements-gpu.lock.txt`, compile pour `x86_64-manylinux2014`. Ce lock
# autonome resout Torch depuis PyPI et ne represente pas exactement l'image
# Serverless cible.
#
# NOTE lock combine Serverless : `requirements-serverless-gpu.in` inclut les
# trois pins ci-dessous, ajoute la roue Torch 2.8.0+cu128 exacte, puis le
# generateur impose CPython 3.12 et `x86_64-manylinux_2_28`. C'est ce lock
# combine qui est candidat pour le worker ; les commentaires du present fichier
# ne changent pas sa cible, decidee par le generateur appelant.
FlagEmbedding==1.3.5
huggingface_hub==0.34.4
transformers==4.57.6
